 'KEYWORDS': '', 'LANG': 'EN', 'UPVOTES': 0, 'DOWNVOTES': 0, 'SCORE': 0, 'SENTIMENT': 'NEUTRAL', 'STATUS': 'ACTIVE', 'CREATED_ON': 1764917740, 'UPDATED_ON': 1765190237, 'SOURCE_DATA': {'TYPE': '120', 'ID': 106, 'SOURCE_KEY': 'investing_comcryptonews', 'NAME': 'Investing.com Crypto News', 'IMAGE_URL': 'https://resources.cryptocompare.com/news/106/default.png', 'URL': 'https://www.investing.com/rss/news_301.rss', 'LANG': 'EN', 'SOURCE_TYPE': 'RSS', 'LAUNCH_DATE': 1505088000, 'SORT_ORDER': 0, 'BENCHMARK_SCORE': 0, 'STATUS': 'ACTIVE', 'LAST_UPDATED_TS': 1765190585, 'CREATED_ON': 1754907212, 'UPDATED_ON': 1754907484}, 'CATEGORY_DATA': [{'TYPE': '122', 'ID': 14, 'NAME': 'BTC', 'CATEGORY': 'BTC'}, {'TYPE': '122', 'ID': 50, 'NAME': 'TRADING', 'CATEGORY': 'TRADING'}, {'TYPE': '122', 'ID': 210, 'NAME': 'MACROECONOMICS', 'CATEGORY': 'MACROECONOMICS'}, {'TYPE': '122', 'ID': 211, 'NAME': 'CRYPTOCURRENCY', 'CATEGORY': 'CRYPTOCURRENCY'}]}, {'TYPE': '121', 'ID': 55502886, 'GUID': 'https://zycrypto.com/?p=113189', 'PUBLISHED_ON': 1765190152, 'PUBLISHED_ON_NS': None, 'IMAGE_URL': 'https://images.cryptocompare.com/news/default/zycrypto.png', 'TITLE': 'Peter Schiff Admits Bitcoin Won’t Go To Zero In The Near Future, Softens Long-Held Stance', 'SUBTITLE': None, 'AUTHORS': 'Aliyu Pokima', 'URL': 'https://zycrypto.com/peter-schiff-admits-bitcoin-wont-go-to-zero-in-the-near-future-softens-long-held-stance/', 'SOURCE_ID': 51, 'BODY': 'Economist Peter Schiff has backpedaled on his long-held stance that Bitcoin (BTC) is headed to zero in the coming years. Fresh off his interview with Binance founder Changpeng Zhao, the gold bug revealed that Bitcoin has garnered enough institutional interest to support prices for the near future. Bitcoin Price Will Not Go To Zero, Says', 'KEYWORDS': 'Bitcoin|News|Bitcoin News|BTCUSD|BTCUSDC|BTCUSDT|Cryptocurrency News|Peter Schiff|XBTUSD', 'LANG': 'EN', 'UPVOTES': 0, 'DOWNVOTES': 0, 'SCORE': 0, 'SENTIMENT': 'POSITIVE', 'STATUS': 'ACTIVE', 'CREATED_ON': 176519