FROM bitnami/spark:3.5.1

USER root
ENV HOME=/root
RUN mkdir -p /root/.ivy2

RUN echo 'exit()' | spark-shell --packages org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.1,org.apache.hadoop:hadoop-aws:3.3.6

WORKDIR /app

COPY requirements.txt pyproject.toml /app/
COPY src/ /app/src/
COPY spark/spark/consumer_price.py /app/consumer_price.py

RUN /opt/bitnami/python/bin/pip install --upgrade pip && \
    /opt/bitnami/python/bin/pip install -r /app/requirements.txt && \
    /opt/bitnami/python/bin/pip install -e /app

ENV PYSPARK_DRIVER_PYTHON=python
ENV PYSPARK_PYTHON=/opt/bitnami/python/bin/python
ENV PYTHONPATH=/app/src

EXPOSE 4040

CMD ["spark-submit", "--packages", "org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.1,org.apache.hadoop:hadoop-aws:3.3.6", "/app/consumer_price.py"]
