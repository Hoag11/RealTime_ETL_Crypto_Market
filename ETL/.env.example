# Kafka configuration
KAFKA_BROKERS=kafka-0:9092,kafka-1:9092,kafka-2:9092
KAFKA_TOPIC=coin_prices
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=admin
KAFKA_SASL_PASSWORD=Unigap@2024

# API endpoints
API_STREAMING_URL=https://api.coinlore.net/api/tickers/
API_BATCHING_URL=https://data-api.coindesk.com/news/v1/article/list?lang=EN&limit=100
API_HISTORICAL_URL=https://api.coingecko.com/api/v3

# MinIO
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123
MINIO_BUCKET_RAW_PRICE=crypto-data-raw
MINIO_BUCKET_RAW_NEWS=crypto-news-raw

# PostgreSQL
POSTGRES_HOST=postgres-bi
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=warehouse

# Spark defaults
SPARK_MASTER=spark-spark-1:7077
SPARK_APP_NAME=streamingCryptoApp
